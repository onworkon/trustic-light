{
  "name": "trustlight",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onworkon/trustic-light.git"
  },
  "homepage": "https://github.com/onworkon/trustic-light#readme",
  "bugs": {
    "url": "https://github.com/onworkon/trustic-light/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "format": "prettier --write src scripts tests docs .github *.json *.md",
    "format:check": "prettier --check src scripts tests docs .github *.json *.md",
    "check:repo": "node scripts/check-repository.mjs",
    "check": "npm run check:repo && npm run typecheck && npm test && npm run build && npm run format:check",
    "package": "npm run check && node scripts/package.mjs",
    "package:source": "npm run check && node scripts/package-source.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
