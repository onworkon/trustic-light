{
  "manifest_version": 3,
  "name": "신뢰등",
  "short_name": "신뢰등",
  "description": "직접 선택한 웹 글의 표현과 근거를 AI로 분석하고, 신호등과 문장별 설명으로 확인하는 읽기 도우미",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "신뢰등 설정 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.anthropic.com; base-uri 'none'; form-action 'none'"
  }
}
